# Copie para .env.local e ajuste. Nenhuma credencial é necessária para a demonstração.

# Domínio de produção (canonical, sitemap, Open Graph). Sem valor: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# "true" libera indexação (meta robots, X-Robots-Tag, robots.txt). Use só na versão aprovada.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "false" desativa o modo demonstração do formulário (exige integração real de envio).
NEXT_PUBLIC_DEMO_MODE=true
